{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "options": {
    "typeAware": true
  },
  "plugins": ["effecttsgo"],
  "rules": {
    "no-nested-ternary": "error",
    "no-throw-literal": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ]
  },
  "ignorePatterns": [
    ".artifacts/**",
    "vendor/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/src/generated/**"
  ]
}
