{
  "name": "@better-native/compatibility-suite",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "typecheck": "tsc --noEmit",
    "build:metro": "bun run --cwd ../../packages/metro build"
  },
  "dependencies": {
    "@better-native/metro": "workspace:*",
    "effect": "4.0.0-beta.102",
    "expo": "57.0.9",
    "expo-constants": "~57.0.8",
    "expo-router": "~57.0.9",
    "jasmine-core": "^5.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@babel/plugin-transform-object-rest-spread": "^7.24.7",
    "@types/jasmine": "^5.1.15",
    "@types/lodash": "^4.17.20",
    "@types/react": "~19.2.0",
    "babel-preset-expo": "~57.0.5"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "expo": {
    "autolinking": {
      "exclude": [
        "expo-module-template"
      ]
    }
  }
}
