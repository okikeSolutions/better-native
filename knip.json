{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": true,
  "rules": {
    "exports": "off",
    "types": "off"
  },
  "workspaces": {
    ".": {
      "project": ["*.ts"]
    },
    "apps/compatibility-suite": {
      "entry": [
        "app/**/*.{ts,tsx}",
        "src/generated/**/*.{ts,tsx}",
        "src/**/*.test.ts",
        "metro.config.cjs"
      ],
      "project": ["app/**/*.{ts,tsx}", "src/**/*.{ts,tsx}", "*.{ts,cjs}"],
      "ignoreIssues": {
        "package.json": ["dependencies", "devDependencies"]
      },
      "ignoreDependencies": ["expo-updates", "@better-native/expo-source"],
      "metro": {
        "config": []
      }
    },
    "packages/metro": {
      "entry": ["src/BetterNativeMetroConfig.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.test.ts"]
    },
    "packages/cli": {
      "entry": ["src/bin.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.test.ts"]
    },
    "packages/metro/test/fixtures/paired": {
      "entry": ["BuildProcess.ts", "index.js"],
      "project": ["*.{ts,js}"],
      "expo": false
    },
    "tooling/compatibility-harness": {
      "entry": ["src/checkGenerated.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "tooling/dx-evals": {
      "entry": ["evals/**/*.eval.ts", "runner/**/*.ts", "src/**/*.test.ts"],
      "project": ["evals/**/*.ts", "runner/**/*.ts", "src/**/*.ts"]
    },
    "tooling/expo-catalog": {
      "ignoreIssues": {
        "package.json": ["dependencies"]
      }
    }
  }
}
