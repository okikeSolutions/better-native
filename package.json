{
  "name": "effect-expo",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run check:knip && bun run typecheck && bun run check:effect && bun run test && bun run check:generated && bun run docs:check",
    "check:knip": "knip --treat-config-hints-as-errors",
    "bundle": "bun run --cwd apps/test-suite export",
    "bundle:android": "bun run --cwd apps/test-suite export:android",
    "bundle:ios": "bun run --cwd apps/test-suite export:ios",
    "bundle:web": "bun run --cwd apps/test-suite export:web",
    "conformance:android": "bun run --cwd apps/test-suite android",
    "conformance:ios": "bun run --cwd apps/test-suite ios",
    "docs:check": "bun run --workspaces --if-present docs",
    "generate": "bun packages/cli/src/bin.ts generate",
    "check:generated": "bun packages/cli/src/bin.ts check",
    "check:effect": "effect-language-service diagnostics --project tsconfig.effect.json --strict",
    "format": "oxfmt --disable-nested-config --write .",
    "format:check": "oxfmt --disable-nested-config --check .",
    "lint": "oxlint --disable-nested-config --max-warnings 0 --report-unused-disable-directives .",
    "lint:fix": "oxlint --disable-nested-config --fix --max-warnings 0 --report-unused-disable-directives .",
    "matrix": "bun packages/cli/src/bin.ts matrix",
    "sim:ios": "serve-sim",
    "typecheck": "bun run --filter '@effect-expo/*' typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@effect-expo/typescript-config": "workspace:*",
    "@effect/docgen": "4.0.0-beta.102",
    "@effect/language-service": "0.87.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/node": "^24.0.0",
    "knip": "6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "serve-sim": "0.1.45",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.0"
  },
  "packageManager": "bun@1.3.14"
}
