{
  "name": "better-native",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/metro/test/fixtures/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-language-service patch",
    "better-native": "bun run tooling/compatibility-harness/src/main.ts",
    "generate": "bun run better-native generate",
    "compatibility": "bun run better-native validate",
    "matrix": "bun run better-native matrix",
    "bundle:web:upstream": "bun run generate && bun run better-native supervise-build --mode upstream --platform web --build-id local-upstream-web",
    "bundle:web:candidate": "bun run generate && bun run better-native supervise-build --mode candidate --platform web --build-id local-candidate-web",
    "typecheck": "bun run --filter '@better-native/*' typecheck",
    "lint": "oxlint --disable-nested-config --config .oxlintrc.json .",
    "format": "oxfmt --disable-nested-config --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --disable-nested-config --config .oxfmtrc.json --check .",
    "check:dist": "bun run --filter '@better-native/metro' check:dist",
    "check:generated": "bun run tooling/compatibility-harness/src/checkGenerated.ts",
    "knip": "knip --reporter compact",
    "security:audit": "bun run better-native security-audit",
    "landing:check": "bun run --filter 'apps-landing' build",
    "test": "vitest run",
    "check": "bun run check:generated && bun run typecheck && bun run lint && bun run format:check && bun run knip && bun run security:audit && bun run test && bun run landing:check && bun run check:dist && bun run compatibility"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-beta.102",
    "knip": "^6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "bun@1.3.14"
}
