{
  "name": "better-native",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/metro/test/fixtures/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "better-native": "bun run tooling/compatibility-harness/src/main.ts",
    "build": "turbo run build --concurrency=90%",
    "bundle:web": "turbo run //#compatibility:web --concurrency=90%",
    "check": "bun run check:generated && bun run typecheck && bun run check:effect && bun run lint && bun run format:check && bun run knip && bun run security:audit && bun run test && bun run landing:check && bun run check:dist && bun run compatibility",
    "check:dist": "turbo run check:dist --filter '@better-native/metro' --concurrency=90%",
    "check:effect": "bun run effect:patch && turbo run check:effect --concurrency=90%",
    "check:generated": "bun run expo:prepare && bun run tooling/compatibility-harness/src/checkGenerated.ts",
    "compatibility": "bun run better-native validate",
    "compatibility:web": "bun run generate && bun run expo:prepare && bun run better-native supervise-web --mode upstream --build-id local-web",
    "effect:patch": "effect-language-service patch",
    "expo:toolchain": "bun run better-native prepare-expo --timeout-ms 3600000",
    "expo:prepare": "turbo run //#expo:toolchain --concurrency=90%",
    "format": "oxfmt --disable-nested-config --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --disable-nested-config --config .oxfmtrc.json --check .",
    "generate": "bun run better-native generate",
    "knip": "knip --reporter compact",
    "landing:check": "turbo run build --filter 'apps-landing' --concurrency=90%",
    "lint": "oxlint --disable-nested-config --config .oxlintrc.json .",
    "matrix": "bun run better-native matrix",
    "prepare": "bun run effect:patch",
    "typecheck": "bun run effect:patch && turbo run typecheck --concurrency=90%",
    "test": "vitest run",
    "security:audit": "bun run better-native security-audit"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/vitest": "4.0.0-beta.102",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-beta.102",
    "knip": "^6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  },
  "packageManager": "bun@1.3.14"
}
