{
  "name": "@better-native/monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/metro/test/fixtures/*",
    "tooling/*"
  ],
  "type": "module",
  "scripts": {
    "compatibility-harness": "node --experimental-strip-types tooling/compatibility-harness/src/cli.ts",
    "artifacts:prune": "bun run compatibility-harness artifacts-prune",
    "artifacts:clean": "bun run compatibility-harness artifacts-clean",
    "build": "turbo run build --concurrency=90%",
    "bundle:web": "turbo run //#compatibility:web --concurrency=90%",
    "benchmark:release": "bun run compatibility-harness benchmark-release-path",
    "check": "bun run check:generated && bun run migration-status --strict && bun run typecheck && bun run check:effect && bun run docs:api && bun run lint && bun run format:check && bun run knip && bun run security:audit && bun run test && bun run landing:check && bun run check:dist && bun run compatibility",
    "check:dist": "turbo run check:dist --filter '@better-native/metro' --concurrency=90%",
    "check:effect": "bun run effect:patch && turbo run check:effect --concurrency=90%",
    "check:generated": "bun run expo:prepare && bun run tooling/compatibility-harness/src/checkGenerated.ts",
    "compatibility": "bun run compatibility-harness validate",
    "compatibility:prepare": "turbo run //#compatibility:dependencies --concurrency=90%",
    "compatibility:web": "bun run generate && bun run compatibility:prepare && bun run compatibility-harness supervise-web --mode upstream --build-id local-web",
    "coverage": "bun run compatibility-harness coverage",
    "docs:api": "turbo run docs:api --concurrency=90%",
    "effect:patch": "effect-language-service patch && effect-tsgo patch --no-typescript --oxlint",
    "evals": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types tooling/dx-evals/src/cli.ts",
    "expo:toolchain": "bun run compatibility-harness prepare-expo --timeout-ms 3600000",
    "expo:prepare": "turbo run //#expo:toolchain --cache=local:rw --concurrency=90%",
    "format": "oxfmt --disable-nested-config --config .oxfmtrc.json --write .",
    "format:check": "oxfmt --disable-nested-config --config .oxfmtrc.json --check .",
    "generate": "bun run compatibility-harness generate",
    "knip": "knip --reporter compact",
    "landing:check": "turbo run build --filter 'apps-landing' --concurrency=90%",
    "lint": "oxlint --disable-nested-config --config .oxlintrc.json .",
    "matrix": "bun run compatibility-harness matrix",
    "migration-status": "node --experimental-strip-types tooling/compatibility-harness/src/migrations/cli.ts",
    "prepare": "bun run effect:patch",
    "typecheck": "bun run effect:patch && turbo run typecheck --concurrency=90%",
    "test": "vitest run",
    "test:local-registry": "node --experimental-strip-types packages/cli/test/LocalRegistryMatrix.ts",
    "test:coverage": "vitest run --coverage",
    "security:audit": "bun run compatibility-harness security-audit"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.1",
    "@effect/tsgo": "0.32.1",
    "@effect/vitest": "4.0.0-rc.112",
    "@types/bun": "1.3.14",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "effect": "4.0.0-rc.112",
    "knip": "^6.31.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10",
    "vitest-evals": "0.15.0"
  },
  "overrides": {
    "@sentry/browser": "7.119.1",
    "@xmldom/xmldom": "0.8.13",
    "fast-xml-parser": "5.7.0",
    "nanoid": "3.3.18",
    "path-to-regexp": "6.3.0",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "uuid": "11.1.1",
    "xml2js": "0.6.2"
  },
  "packageManager": "bun@1.3.14"
}
