{
  "name": "@better-native/background-task",
  "version": "0.0.1-alpha.1",
  "private": false,
  "description": "Effect-native Expo Background Task integration.",
  "keywords": [
    "background-task",
    "effect",
    "expo",
    "react-native"
  ],
  "homepage": "https://github.com/okikeSolutions/better-native/tree/main/packages/background-task#readme",
  "bugs": "https://github.com/okikeSolutions/better-native/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okikeSolutions/better-native.git",
    "directory": "packages/background-task"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./expo": {
      "types": "./build/Expo.d.ts",
      "import": "./build/Expo.js",
      "default": "./build/Expo.js"
    },
    "./app.plugin": {
      "types": "./build/Plugin.d.ts",
      "import": "./build/Plugin.js",
      "default": "./build/Plugin.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "vitest run --root ../.. packages/background-task/test",
    "typecheck": "tsc --noEmit",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "docs:api": "docgen",
    "test:unit": "vitest run --config ../../vitest.unit.config.ts packages/background-task/",
    "test:coverage": "BETTER_NATIVE_COVERAGE_PACKAGE=background-task vitest run --config ../../vitest.coverage.config.ts --coverage packages/background-task/"
  },
  "devDependencies": {
    "@better-native/task-manager": "workspace:*",
    "@effect/docgen": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "expo": "57.0.9",
    "expo-background-task": "57.0.7",
    "react": "19.2.3"
  },
  "peerDependencies": {
    "@better-native/task-manager": "0.0.1-alpha.1",
    "effect": "4.0.0-rc.112",
    "expo-background-task": ">=57.0.0 <58.0.0",
    "expo-task-manager": ">=57.0.0 <58.0.0"
  }
}
