{
  "name": "better-native",
  "version": "0.0.1-alpha.1",
  "private": false,
  "description": "Install and diagnose Better Native capabilities in Expo applications.",
  "keywords": [
    "cli",
    "effect",
    "expo",
    "react-native"
  ],
  "homepage": "https://github.com/okikeSolutions/better-native/tree/main/packages/cli#readme",
  "bugs": "https://github.com/okikeSolutions/better-native/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okikeSolutions/better-native.git",
    "directory": "packages/cli"
  },
  "bin": {
    "better-native": "dist/bin.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/bin.ts --target=node --format=esm --outfile=dist/bin.js",
    "prepack": "bun run build",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
