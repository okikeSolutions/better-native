{
  "name": "@better-native/network",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/okikeSolutions/better-native#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/okikeSolutions/better-native.git",
    "directory": "packages/network"
  },
  "files": [
    "build"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./expo": {
      "types": "./build/Expo.d.ts",
      "import": "./build/Expo.js"
    }
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "docs:api": "docgen --out ../../.artifacts/docs/api/network",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/docgen": "4.0.0-beta.102",
    "expo": "57.0.9",
    "expo-modules-core": "3.0.11",
    "expo-network": "57.0.1",
    "react": "19.2.3"
  },
  "peerDependencies": {
    "expo": ">=57.0.0 <58.0.0",
    "expo-modules-core": ">=3.0.0 <4.0.0",
    "expo-network": ">=57.0.0 <58.0.0",
    "react": ">=19.0.0"
  }
}
