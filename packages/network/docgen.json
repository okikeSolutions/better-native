{
  "$schema": "../../node_modules/@effect/docgen/schema.json",
  "srcLink": "https://github.com/okikeSolutions/effect-expo/tree/main/packages/network/src/",
  "outDir": "../../.artifacts/api-docs/network",
  "exclude": ["src/index.ts", "src/adapters/NetworkAdapter.ts"],
  "enforceDescriptions": true,
  "examplesCompilerOptions": {
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ESNext", "DOM"],
    "allowImportingTsExtensions": true,
    "paths": {
      "effect": ["../../../../packages/network/node_modules/effect/src/index.ts"],
      "effect/*": ["../../../../packages/network/node_modules/effect/src/*.ts"],
      "@effect-expo/network": ["../../../../packages/network/src/index.ts"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": false
      }
    ]
  }
}
