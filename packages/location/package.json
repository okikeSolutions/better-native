{
  "name": "@better-native/location",
  "version": "0.0.1-alpha.1",
  "private": false,
  "description": "Effect-native location, geocoding, permissions, and background tracking for Expo applications.",
  "keywords": [
    "effect",
    "expo",
    "geolocation",
    "location",
    "react-native"
  ],
  "homepage": "https://github.com/okikeSolutions/better-native/tree/main/packages/location#readme",
  "bugs": "https://github.com/okikeSolutions/better-native/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okikeSolutions/better-native.git",
    "directory": "packages/location"
  },
  "files": [
    "build",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    },
    "./expo": {
      "types": "./build/Expo.d.ts",
      "import": "./build/Expo.js",
      "default": "./build/Expo.js"
    },
    "./app.plugin": {
      "types": "./build/Plugin.d.ts",
      "import": "./build/Plugin.js",
      "default": "./build/Plugin.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "vitest run --root ../.. packages/location/test",
    "typecheck": "tsc --noEmit",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "docs:api": "docgen"
  },
  "devDependencies": {
    "@better-native/task-manager": "workspace:*",
    "@effect/docgen": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "expo": "57.0.9",
    "expo-location": "57.0.7",
    "react": "19.2.3"
  },
  "peerDependencies": {
    "@better-native/task-manager": "0.0.1-alpha.1",
    "effect": "4.0.0-rc.112",
    "expo-location": ">=57.0.0 <58.0.0"
  },
  "peerDependenciesMeta": {
    "@better-native/task-manager": {
      "optional": true
    }
  }
}
