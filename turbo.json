{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": ["compatibility/upstreams.json", "bun.lock"],
  "globalPassThroughEnv": ["CI", "EXPO_SOURCE_ROOT", "GITHUB_SHA"],
  "remoteCache": {
    "signature": true
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!build/**", "!dist/**"],
      "outputs": ["build/**", "dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "@better-native/compatibility-suite#typecheck": {
      "dependsOn": ["^typecheck", "^build"],
      "outputs": []
    },
    "check:effect": {
      "dependsOn": ["typecheck"],
      "outputs": []
    },
    "check:dist": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "docs:api": {
      "outputs": ["../../.artifacts/docs/api/**"]
    },
    "evals:validate": {
      "cache": false,
      "dependsOn": [
        "typecheck",
        "check:effect",
        "@better-native/network#build",
        "@better-native/battery#build",
        "@better-native/keep-awake#build",
        "@better-native/secure-store#build",
        "@better-native/sqlite#build",
        "@better-native/task-manager#build",
        "@better-native/background-task#build",
        "@better-native/location#build",
        "@better-native/notifications#build"
      ],
      "passThroughEnv": ["BETTER_NATIVE_EVAL_RUN_ID"],
      "outputs": []
    },
    "evals:live": {
      "cache": false,
      "dependsOn": [
        "typecheck",
        "check:effect",
        "@better-native/network#build",
        "@better-native/battery#build",
        "@better-native/keep-awake#build",
        "@better-native/secure-store#build",
        "@better-native/sqlite#build",
        "@better-native/task-manager#build",
        "@better-native/background-task#build",
        "@better-native/location#build",
        "@better-native/notifications#build"
      ],
      "passThroughEnv": [
        "OPENROUTER_API_KEY",
        "BETTER_NATIVE_EVAL_LIVE",
        "BETTER_NATIVE_EVAL_CAMPAIGN",
        "BETTER_NATIVE_EVAL_TASK",
        "BETTER_NATIVE_EVAL_PROFILE",
        "BETTER_NATIVE_EVAL_RUN_ID",
        "BETTER_NATIVE_EVAL_CAMPAIGN_MAX_COST_USD"
      ],
      "outputs": []
    },
    "//#compatibility:dependencies": {
      "cache": false,
      "dependsOn": [
        "//#expo:toolchain",
        "@better-native/network#build",
        "@better-native/battery#build",
        "@better-native/keep-awake#build",
        "@better-native/secure-store#build",
        "@better-native/sqlite#build",
        "@better-native/task-manager#build",
        "@better-native/background-task#build",
        "@better-native/location#build",
        "@better-native/notifications#build",
        "@better-native/metro#build"
      ],
      "outputs": []
    },
    "//#compatibility:web": {
      "cache": false,
      "dependsOn": ["//#compatibility:dependencies"],
      "outputs": []
    },
    "//#expo:toolchain": {
      "cache": false,
      "inputs": [
        "compatibility/upstreams.json",
        "apps/compatibility-suite/package.json",
        "bun.lock",
        "tooling/compatibility-harness/src/build/**"
      ],
      "outputs": []
    }
  }
}
