# Optional local override for the Expo source checkout used by compatibility research.
# Defaults to ../expo when omitted.
EXPO_SOURCE_ROOT=/absolute/path/to/expo

# Defaults for manually running the compatibility Metro configuration.
BETTER_NATIVE_MODE=upstream
BETTER_NATIVE_BUILD_ID=local
BETTER_NATIVE_RUN_ID=local
BETTER_NATIVE_PINNED_EXPO_ROOT=/absolute/path/to/expo
BETTER_NATIVE_UPSTREAM_NODE_MODULES=/absolute/path/to/expo/node_modules

# Optional remote Turbo cache credentials.
# TURBO_TEAM=
# TURBO_TOKEN=
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=
