# Optional local override for the Expo source checkout used by compatibility research.
# Defaults to ../expo when omitted.
EXPO_SOURCE_ROOT=/absolute/path/to/expo

# Defaults for manually running the compatibility Metro configuration.
BETTER_NATIVE_MODE=upstream
BETTER_NATIVE_BUILD_ID=local
BETTER_NATIVE_RUN_ID=local
BETTER_NATIVE_PINNED_EXPO_ROOT=/absolute/path/to/expo
BETTER_NATIVE_UPSTREAM_NODE_MODULES=/absolute/path/to/expo/node_modules

# Native build policy. CI selects a concrete iOS simulator destination.
BETTER_NATIVE_IOS_DESTINATION=generic/platform=iOS Simulator
BETTER_NATIVE_FORCE_COLD_BUILD=false
# CCACHE_DIR=/absolute/path/to/ccache

# Cache evidence populated by the GitHub Actions setup profiles. These local
# defaults explicitly describe an uncached build.
BETTER_NATIVE_PNPM_STORE_CACHE_HIT=false
BETTER_NATIVE_PNPM_STORE_CACHE_KEY=local-disabled
BETTER_NATIVE_CCACHE_CACHE_HIT=false
BETTER_NATIVE_CCACHE_CACHE_KEY=local-disabled
BETTER_NATIVE_GRADLE_CACHE_KEY=local-disabled
BETTER_NATIVE_PODS_CACHE_HIT=false
BETTER_NATIVE_PODS_CACHE_KEY=local-disabled

# Optional remote Turbo cache credentials.
# GITHUB_SHA=
# TURBO_TEAM=
# TURBO_TOKEN=
# TURBO_REMOTE_CACHE_SIGNATURE_KEY=

# Reusable dedicated OpenRouter key for paid live eval campaigns. Configure a
# finite server-side limit no greater than the reviewed global USD 10 ceiling.
OPENROUTER_API_KEY=

# Eval control values are normally set or generated by the eval commands.
# BETTER_NATIVE_EVAL_LIVE=1
# BETTER_NATIVE_EVAL_CAMPAIGN=checkpoint-5-diagnostic
# BETTER_NATIVE_EVAL_TASK=all
# BETTER_NATIVE_EVAL_PROFILE=all
# BETTER_NATIVE_EVAL_RUN_ID=local-campaign-id
# BETTER_NATIVE_EVAL_CAMPAIGN_MAX_COST_USD=8
