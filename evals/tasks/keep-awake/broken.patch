--- a/src/HoldScreenAwake.ts
+++ b/src/HoldScreenAwake.ts
@@ -1,3 +1,9 @@
+import { KeepAwake } from "@better-native/keep-awake"
 import * as Effect from "effect/Effect"
-
-export const holdScreenAwake = Effect.void
+
+export const holdScreenAwake = Effect.gen(function* () {
+  const available = yield* KeepAwake.isAvailableAsync
+  if (!available) return yield* new KeepAwake.KeepAwakeUnavailable({ method: "activateKeepAwakeAsync" })
+  yield* KeepAwake.activateKeepAwakeAsync("dx-eval")
+  return yield* Effect.never
+}).pipe(Effect.provide(KeepAwake.live))
