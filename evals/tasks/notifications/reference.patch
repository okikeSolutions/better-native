@@ -1,3 +1,16 @@
-import * as Effect from "effect/Effect"
-
-export const observeNotification = Effect.succeed("missing")
+import { Notifications } from "@better-native/notifications"
+import * as Effect from "effect/Effect"
+import * as Option from "effect/Option"
+import * as Stream from "effect/Stream"
+
+export const observeNotification = Notifications.addNotificationReceivedListener.pipe(
+  Stream.runHead,
+  Effect.map(
+    Option.match({
+      onNone: () => "missing",
+      onSome: (notification: Notifications.Notification) =>
+        notification.request.identifier,
+    }),
+  ),
+  Effect.provide(Notifications.live),
+)
