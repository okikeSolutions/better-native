--- a/src/ReadNetwork.ts
+++ b/src/ReadNetwork.ts
@@ -1,6 +1,23 @@
+import * as Network from "@better-native/network"
 import * as Effect from "effect/Effect"
 import * as Schema from "effect/Schema"
 
-export const NetworkSnapshot = Schema.Unknown
+export const NetworkSnapshot = Schema.Union([
+  Schema.Struct({
+    status: Schema.Literal("available"),
+    state: Network.NetworkState,
+  }),
+  Schema.Struct({
+    status: Schema.Literal("failure"),
+    method: Schema.String,
+  }),
+])
 
-export const readNetwork = Effect.succeed({ status: "not-implemented" })
+export const readNetwork = Network.getNetworkStateAsync.pipe(
+  Effect.map((state) => ({ status: "available" as const, state })),
+  Effect.catch((error) =>
+    Effect.succeed({ status: "failure" as const, method: error.method }),
+  ),
+  Effect.flatMap(Schema.decodeUnknownEffect(NetworkSnapshot)),
+  Effect.provide(Network.live),
+)
