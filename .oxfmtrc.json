{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "none",
  "proseWrap": "preserve",
  "sortPackageJson": true,
  "ignorePatterns": [
    "vendor/**",
    "node_modules/**",
    "**/dist/**",
    "**/.expo/**",
    "coverage/**",
    "packages/catalog/src/generated/**",
    "packages/network/src/generated/**",
    "bun.lock"
  ]
}
